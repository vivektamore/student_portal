{
  "name": "college-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "postinstall": "npm run db:generate",
    "start": "next start",
    "lint": "eslint",
    "prisma": "node --experimental-require-module ./node_modules/prisma/build/index.js",
    "db:generate": "node --experimental-require-module ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --experimental-require-module ./node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --experimental-require-module ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:clear": "node scripts/clear-database.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "jose": "^6.2.12",
    "lucide-react": "^1.54.0",
    "mariadb": "^3.5.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.29",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
